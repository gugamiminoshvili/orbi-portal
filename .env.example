# Copy this file to .env (and adjust) to configure the app locally.
# See README.md "Backend integration" for the full mode matrix.

# true (default): every screen runs on in-memory mock data, no login
# required. false: routes all requests through VITE_API_BASE with real auth.
VITE_USE_MOCK=true

# Real-API origin (and optional path prefix), e.g. https://api.orbi.example.com
# Ignored while VITE_USE_MOCK=true. Also read by `vite.config.js` to decide
# whether to start the dev proxy (see VITE_USE_PROXY below) and by
# `scripts/live-smoke.mjs`.
VITE_API_BASE=

# Base of the persCabApi host, used by two calls only: daily electricity
# readings and the payment-method list (client.js persCab()). Defaults to
# https://apimyorbi.orbi.ge:15043 when unset. Not covered by the dev proxy,
# so it needs CORS on that host for your dev origin.
VITE_PERSCAB_BASE=

# Dev-only. true: the dev server proxies /mobileApi/* to VITE_API_BASE (see
# vite.config.js) and the app calls relative /mobileApi/... paths so requests
# hit that proxy instead of VITE_API_BASE directly — avoids CORS in dev
# without needing the backend to allow the dev origin. Leave unset/false to
# call VITE_API_BASE directly (needs CORS enabled on the backend for your dev
# origin). Has no effect in a production build (there is no dev server there
# to proxy through) — always unset/false for `vite build`/`vite preview`.
VITE_USE_PROXY=false

# Test-account credentials for `bun run smoke` (scripts/live-smoke.mjs) only.
# Put these in .env.local instead of this file or .env — .env.local is
# gitignored and is never read by the app itself, only by the smoke script.
# NEVER commit real credentials.
# VITE_TEST_USER=
# VITE_TEST_PASS=
